# ── Python ───────────────────────────────────────────────
# Скомпилированный байт-код: Python генерирует его сам при запуске.
__pycache__/
*.pyc
*.pyo

# ── Виртуальное окружение ────────────────────────────────
# Восстанавливается командой: pip install -r requirements.txt
venv/
.venv/
env/

# ── Секреты ──────────────────────────────────────────────
# .env хранит SECRET_KEY и пароль от БД. В репозиторий не попадает никогда.
# Образец без реальных значений лежит в .env.example.
.env

# ── База данных ──────────────────────────────────────────
# Локальная БД разработчика. Наполняется командой: python manage.py seed_products
db.sqlite3
*.sqlite3

# ── Логи ─────────────────────────────────────────────────
*.log
logs/

# ── Медиафайлы ───────────────────────────────────────────
# ВАЖНО: media/products/ НЕ игнорируется — это демо-картинки каталога,
# без них проект не воспроизводится после клонирования.
# Здесь перечисляем только то, что загружают пользователи в процессе работы.
media/uploads/

# ── Служебное ────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db

# Локальный файл-указатель на docs/project-context.md.
# Нужен только инструментам разработчика, в репозитории ему делать нечего.
CLAUDE.md

# ── Тесты и покрытие ─────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
