# Образец файла окружения.
#
# Скопируйте его в .env и подставьте свои значения:
#     copy .env.example .env
#
# Сам .env в репозиторий не попадает — в нём лежат секреты.
# Сгенерировать новый SECRET_KEY:
#     venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Ключ подписи сессий и токенов сброса пароля. Уникален для каждой установки.
SECRET_KEY=

# Режим отладки. На боевом сервере обязательно False.
DEBUG=True

# Хосты, с которых разрешено обслуживать запросы (через запятую).
ALLOWED_HOSTS=127.0.0.1,localhost
